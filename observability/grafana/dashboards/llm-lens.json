{
  "title": "LLM Lens",
  "uid": "llm-lens-v1",
  "schemaVersion": 38,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Cost (USD) — last hour by feature",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 6
        }
      },
      "targets": [
        {
          "expr": "sum by (feature) (increase(llm_cost_usd_total[1h]))",
          "legendFormat": "{{feature}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Tokens / minute by feature",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (feature) (rate(llm_tokens_input_total[1m]) + rate(llm_tokens_output_total[1m]))",
          "legendFormat": "{{feature}} total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency p95 (seconds) by feature",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (feature, le) (rate(llm_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{feature}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Error rate by error_type",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (feature, error_type) (rate(llm_request_errors_total[5m]))",
          "legendFormat": "{{feature}} / {{error_type}}",
          "refId": "A"
        }
      ]
    }
  ]
}
